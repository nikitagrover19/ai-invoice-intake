# Copy this file to .env and fill in your key to enable LLM-based extraction.
# Without a key, the pipeline falls back to heuristic regex parsing - it still
# runs end-to-end, just less robustly on messy/varied invoice formats.
#
# Get a FREE key (no credit card required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model. Defaults to gemini-3.5-flash.
# gemini-3.1-flash-lite is a lighter/faster free-tier alternative with higher
# rate limits, if you're running many demo takes back to back.
# GEMINI_MODEL=gemini-3.1-flash-lite
